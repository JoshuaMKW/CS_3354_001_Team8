# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values.
# The server reads environment variables, not this file. Load it before starting:
#   set -a; source backend/.env; set +a

# Supabase "Session pooler" connection string (Project -> Connect). Leave empty to use SQLite.
CRAMBERRY_DATABASE_URL=

# SQLite file, used only when CRAMBERRY_DATABASE_URL is empty.
CRAMBERRY_SQLITE_PATH=cramberry.db

# AI. Set ONE key. OpenRouter is used if both are set.
# Without a key, schedules come from the local planner and /api/agent/chat returns 503.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# 1 lets the model reason first: slower (can pass the 10 s limit) and costlier.
OPENROUTER_REASONING=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Listen address. Use 0.0.0.0 inside Docker or on a host.
CRAMBERRY_HOST=127.0.0.1
CRAMBERRY_PORT=8080

# Frontend origin allowed by CORS, e.g. http://localhost:3000
CRAMBERRY_CORS_ORIGIN=
