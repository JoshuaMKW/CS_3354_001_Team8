        <mxCell id="u185" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;——— association&lt;br&gt;◆—— composition (◆ = whole)&lt;br&gt;- - - &amp;gt; dependency&lt;br&gt;- - - ▷ realization&lt;br&gt;Box on a dashed line = association class&lt;br&gt;-  private &amp;nbsp; +  public&lt;br&gt;1, 0..1, 0..*  = multiplicity&lt;br&gt;&lt;span style=&quot;background-color:#F9D9E6&quot;&gt;&amp;nbsp;pink&amp;nbsp;&lt;/span&gt; = added in Phase 4" style="fontFamily=Nunito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNunito;text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#35243D;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="2440" y="1094" width="520" height="330" as="geometry" /></mxCell>
